# Optional HTTPS JSON feed for protocol checks, service checks and measured history.
# See docs/monitoring.md. With no feed, enabled website and update-server checks still run.
STATUS_FEED_URL=
# Optional bearer token, used only on the server. Never use a PUBLIC_ prefix.
STATUS_FEED_TOKEN=
# Production-only private Vercel Blob store, connected using OIDC.
HISTORY_STORE_ID=
# Secret bearer token supplied automatically by Vercel Cron. Server-only.
CRON_SECRET=
